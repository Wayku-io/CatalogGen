# Cookie de session récupéré depuis l'inspecteur web (ligne sessionid ou cookie complet)
MDBLIST_COOKIE=votre_cookie_session_ici

# (Optionnel) Clé API officielle MDBList pour récupérer le nom des listes proprement
# Disponible sur https://mdblist.com/preferences/
MDBLIST_API_KEY=

# (Optionnel) Liste manuelle d'IDs si l'auto-détection n'est pas utilisée
MDBLIST_IDS=168436
